# @BotFather bergan token
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Asosiy adminlarning Telegram ID lari, vergul bilan (ID ni botga /id yozib bilish mumkin).
# Ular botdagi «👥 Adminlar» bo'limida boshqa adminlarni qo'sha va olib tashlay oladi.
ADMIN_IDS=123456789,987654321

# Yangi arizalar tushadigan guruh ID si (botni guruhga qo'shib, guruhda /id yozing).
# Bo'sh qoldirilsa, arizalar har bir adminga shaxsan yuboriladi.
ADMIN_CHAT_ID=

# E'lonlar joylanadigan kanal: @kanal_nomi yoki -100... (bot kanalga admin bo'lishi kerak).
# Bo'sh qoldirilsa, «Kanalga e'lon qilish» tugmasi chiqmaydi.
CHANNEL_ID=

# Ma'lumotlar papkasi (baza va to'ldirilgan arizalar). Odatda o'zgartirish shart emas.
# DATA_DIR=/opt/newtalentsuzb_bot/data
